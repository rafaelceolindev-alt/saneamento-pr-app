<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sanep_blue_primary">

    <!-- Ícone de gota -->
    <ImageView
        android:id="@+id/dropIcon"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_centerInParent="true"
        android:contentDescription="@string/icone_saneamento"
        android:src="@drawable/ic_water_drop"
        app:tint="@color/white" />

    <!-- Texto -->
    <TextView
        android:id="@+id/textSplash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/dropIcon"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:text="@string/titulo_splash"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

</RelativeLayout>

