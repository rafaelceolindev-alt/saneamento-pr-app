<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema padrão da aplicação -->
    <style name="Theme.SaneamentoPR" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_700</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="android:statusBarColor">@color/teal_700</item>
    </style>

    <!-- Tema sem barra de título (para SplashActivity) -->
    <style name="Theme.SaneamentoPR.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/teal_700</item>
        <item name="android:windowBackground">@color/sanep_blue_light</item>
        <item name="android:colorAccent">@color/sanep_blue_dark</item>

    </style>
</resources>
